build/
build-*/
install/

# Generated certificates and private keys (lab/gen-certs.sh). A server's private key is its
# identity - it is generated per deployment and never committed.
lab/certs/
*.pem
*.key
*.crt
*.pin
*.srl

# Vault device private keys. The client writes these under data/ (already ignored below), but the
# rule is deliberately broader: a device's private half must never reach the repository.
devices.json

# Local runtime data (sample server/client roots, test fixtures)
data/

# Test artifacts
test_logs/
__pycache__/
*.pyc

# Large binary fixtures generated by tests/generate50mb.py and friends
*.bin

# Claude Code planning/config — local only, not part of the published project
.claude/
CLAUDE.md
