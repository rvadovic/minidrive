# The OpenSSL embedded in every released client (Linux, Windows, macOS).
#
# The client links OpenSSL statically, so it does not pick up distribution security updates: a
# fixed OpenSSL CVE means bumping these two lines and cutting a new client release. The server does
# NOT use this - it links Debian 13's libssl dynamically and apt keeps it patched.
#
# Stay on the 3.5 LTS line: 3.5 is the first release with ML-KEM, which the hybrid TLS group
# X25519MLKEM768 and vault device enrollment both need. .github/workflows/openssl-watch.yml checks
# weekly for a newer 3.5.x and opens an issue when this pin falls behind.
#
# The checksum is the one OpenSSL publishes beside the tarball
# (https://github.com/openssl/openssl/releases/download/openssl-<ver>/openssl-<ver>.tar.gz.sha256).
# Read by packaging/build-openssl.sh and by the workflows; keep it KEY=VALUE with no spaces.
OPENSSL_VERSION=3.5.8
OPENSSL_SHA256=a8f84a39918ec6415ce765d9b429d313ba97b8143169c172e734b9514464f5b2
